      m_Items: []
  - m_Id: 13347642891223040
    m_Localized: "-{0}s \u0110\u1ED9 tr\u1EC5 t\u1EF1 tung"
    m_Metadata:
      m_Items: []
  - m_Id: 13347643918827520
    m_Localized: "Monolith L VIII \u0111\u1ECBnh k\u1EF3 b\u1EAFn tia laser v\xE0o \u0111\xE1 \u0111ang bay v\xE0 t\u0103ng h\u1EC7 s\u1ED1 nh\xE2n t\u1EA1m th\u1EDDi c\u1EE7a ch\xFAng."
    m_Metadata:
      m_Items: []
  - m_Id: 13347645126787072
    m_Localized: "M\u1EDF kh\xF3a \u0110\xE1 P1"
    m_Metadata:
      m_Items: []
  - m_Id: 13347645126787073
    m_Localized: "Sau khi ti\u1EBFp \u0111\u1EA5t, \u0110\xE1 P1 c\xF3 t\u1EC9 l\u1EC7 tung l\xEAn l\u1EA7n n\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 13347645487497216
    m_Localized: "M\u1EDF kh\xF3a \u0110\xE1 P2"
    m_Metadata:
      m_Items: []
  - m_Id: 13347645487497217
    m_Localized: "Khi n\u1EB1m tr\xEAn m\u1EB7t \u0111\u1EA5t, \u0110\xE1 P2 s\u1EBD c\u1ED1 t\u1EF1 tung."
    m_Metadata:
      m_Items: []
