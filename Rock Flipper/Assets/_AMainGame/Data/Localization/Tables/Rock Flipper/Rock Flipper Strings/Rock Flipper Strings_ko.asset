  - m_Id: 13300708134535168
    m_Localized: "\uB2E4\uC74C \uC120\uD638 \uBC30\uACBD:"
    m_Metadata:
      m_Items: []
  - m_Id: 13300936485027840
    m_Localized: "\uC120\uD638"
    m_Metadata:
      m_Items: []
  - m_Id: 13301272792711168
    m_Localized: "\uB79C\uB364 \uD574\uAE08"
    m_Metadata:
      m_Items: []
  - m_Id: 13302028673400832
    m_Localized: "\uD50C\uB9AC\uD37C \uBD07"
    m_Metadata:
      m_Items: []
  - m_Id: 13302979580837888
    m_Localized: "\uBE68\uAC04 \uC810\uC774 \uC788\uB294 \uC544\uC774\uD15C\uC740 \uC0C8\uB85C \uCC3E\uC558\uAC70\uB098 \uB808\uBCA8 \uC5C5\uD55C \uC544\uC774\uD15C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 13303223290871808
    m_Localized: "\uBAA8\uB450 \uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 13304211712163840
    m_Localized: "\uC88B\uC544, \uD50C\uB9BD\uD558\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 13304398807482368
    m_Localized: "<b>Rock Flipper</b>\uC758 <b>\uB370\uBAA8</b> \uBC84\uC804\uC744 \uD50C\uB808\uC774\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC774 \uB370\uBAA8\uC5D0\uC11C\uB294 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294 \uC2A4\uD0AC\uACFC \uC544\uC774\uD15C\uC774 <b>\uC81C\uD55C</b>\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 13345685015281664
    m_Localized: "\uBC30\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 13349067394301952
    m_Localized: "\uD50C\uB9AC\uD37C \uBD07"
    m_Metadata:
      m_Items: []
  - m_Id: 13349071173369856
    m_Localized: "\uBAA8\uB178\uB9AC\uC2A4 L VIII"
    m_Metadata:
      m_Items: []
  - m_Id: 13349072561684480
    m_Localized: "\uBAA8\uB178\uB9AC\uC2A4 L II"
    m_Metadata:
      m_Items: []
  - m_Id: 13349073006280704
    m_Localized: "\uB9C8\uC6B0\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 13349075195707392
    m_Localized: "\uBAA8\uB4E0 \uB3CC"
    m_Metadata:
      m_Items: []
  - m_Id: 13349348899209216
    m_Localized: "\uBAA8\uB178\uB9AC\uC2A4 L IV"
    m_Metadata:
      m_Items: []
  - m_Id: 13349349234753536
    m_Localized: "\uBAA8\uB178\uB9AC\uC2A4 L VI"
    m_Metadata:
      m_Items: []
  - m_Id: 13349349897453568
    m_Localized: "\uBAA8\uB178\uB9AC\uC2A4 L X"
    m_Metadata:
      m_Items: []
  - m_Id: 13349350212026368
    m_Localized: "\uBAA8\uB178\uB9AC\uC2A4 L XII"
    m_Metadata:
      m_Items: []
  - m_Id: 13351213242171392
    m_Localized: "<b>\uB370\uBAA8 \uC81C\uD55C!</b>\n\n\uB370\uBAA8\uC758 \uAC15\uD654 \uD55C\uB3C4\uC5D0 \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4. \uC815\uC2DD \uBC84\uC804\uC5D0\uC11C\uB294 \uACC4\uC18D \uAC15\uD654\uD558\uACE0 \uB354 \uB9CE\uC740 \uC2A4\uD0AC\uC744 \uD574\uAE08\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<b>\uD074\uB9AD\uD558\uC5EC \uC815\uC2DD \uBC84\uC804\uC744 \uD655\uC778\uD558\uC138\uC694.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616768
    m_Localized: "\uB354 \uB9CE\uC740 \uBC30\uACBD\uC744 \uD574\uAE08\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616769
    m_Localized: "\uC120\uD638 \uBC30\uACBD\uC744 \uC120\uD0DD\uD558\uBA74 \uCE90\uC2DC \uC218\uC785\uC5D0 \uBC30\uC728\uC774 \uC801\uC6A9\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616770
    m_Localized: "\uC120\uD638 \uBC30\uACBD: \uCE90\uC2DC \uC218\uC785 {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616771
    m_Localized: "\uB354 \uB9CE\uC740 \uBC30\uACBD\uC744 \uD574\uAE08\uD558\uBA74 \uBC30\uC728\uC774 \uC62C\uB77C\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616772
    m_Localized: "\uC544\uC9C1 \uCC3E\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496839811072
    m_Localized: "\uD68D\uB4DD\uD55C \uCE90\uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496839811073
    m_Localized: "\uC544\uC774\uD15C \uB808\uBCA8\uC5D0 \uB530\uB77C \uD6A8\uACFC\uAC00 \uAC15\uD574\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005376
    m_Localized: "\uC77C\uBC18"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005377
    m_Localized: "\uACE0\uAE09"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005378
