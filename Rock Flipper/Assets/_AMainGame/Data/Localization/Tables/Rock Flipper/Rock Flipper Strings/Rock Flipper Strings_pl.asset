  m_TableData:
  - m_Id: 7059745456128
    m_Localized: "Kamie\u0144 P0"
    m_Metadata:
      m_Items: []
  - m_Id: 7130968932352
    m_Localized: "Kamie\u0144 P1"
    m_Metadata:
      m_Items: []
  - m_Id: 7173725667328
    m_Localized: "Kamie\u0144 P2"
    m_Metadata:
      m_Items: []
  - m_Id: 7208756494336
    m_Localized: "Kamie\u0144 P3"
    m_Metadata:
      m_Items: []
  - m_Id: 7238640910336
    m_Localized: "Kamie\u0144 P4"
    m_Metadata:
      m_Items: []
  - m_Id: 7262829461504
    m_Localized: "Kamie\u0144 P5"
    m_Metadata:
      m_Items: []
  - m_Id: 13300708134535168
    m_Localized: "Nast\u0119pne ulubione t\u0142o:"
    m_Metadata:
      m_Items: []
  - m_Id: 13300936485027840
    m_Localized: Ulubione
    m_Metadata:
      m_Items: []
  - m_Id: 13301272792711168
    m_Localized: Odblokuj losowe
    m_Metadata:
      m_Items: []
  - m_Id: 13302028673400832
    m_Localized: "Bot podrzucaj\u0105cy"
    m_Metadata:
      m_Items: []
  - m_Id: 13302979580837888
    m_Localized: "Przedmioty z czerwon\u0105 kropk\u0105 s\u0105 nowe lub awansowa\u0142y na wy\u017Cszy poziom."
    m_Metadata:
      m_Items: []
  - m_Id: 13303223290871808
    m_Localized: Ukryj wszystkie
    m_Metadata:
      m_Items: []
  - m_Id: 13304211712163840
    m_Localized: OK, podrzucam!
    m_Metadata:
      m_Items: []
  - m_Id: 13304398807482368
    m_Localized: "Grasz w wersj\u0119 <b>demo</b> gry <b>Rock Flipper</b>. To demo <b>ogranicza</b> dost\u0119pne umiej\u0119tno\u015Bci i przedmioty."
    m_Metadata:
      m_Items: []
  - m_Id: 13345685015281664
    m_Localized: "T\u0142a"
    m_Metadata:
      m_Items: []
  - m_Id: 13349067394301952
    m_Localized: "Boty podrzucaj\u0105ce"
    m_Metadata:
      m_Items: []
  - m_Id: 13349071173369856
    m_Localized: Monolit L VIII
    m_Metadata:
      m_Items: []
  - m_Id: 13349072561684480
    m_Localized: Monolit L II
    m_Metadata:
      m_Items: []
  - m_Id: 13349073006280704
    m_Localized: Mysz
    m_Metadata:
      m_Items: []
  - m_Id: 13349075195707392
    m_Localized: Wszystkie kamienie
    m_Metadata:
      m_Items: []
  - m_Id: 13349348899209216
    m_Localized: Monolit L IV
    m_Metadata:
      m_Items: []
  - m_Id: 13349349234753536
    m_Localized: Monolit L VI
    m_Metadata:
      m_Items: []
  - m_Id: 13349349897453568
    m_Localized: Monolit L X
    m_Metadata:
      m_Items: []
  - m_Id: 13349350212026368
    m_Localized: Monolit L XII
    m_Metadata:
      m_Items: []
  - m_Id: 13351213242171392
    m_Localized: "<b>LIMIT DEMO!</b>\n\nTo limit ulepsze\u0144 w wersji demo. W pe\u0142nej wersji mo\u017Cesz ulepsza\u0107 dalej i odblokowa\u0107 wi\u0119cej umiej\u0119tno\u015Bci.\n\n<b>Kliknij, aby pozna\u0107 pe\u0142n\u0105 wersj\u0119.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616768
    m_Localized: "Odblokuj wi\u0119cej te\u0142!"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616769
    m_Localized: "Wybierz ulubione t\u0142o, aby pomno\u017Cy\u0107 doch\xF3d."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616770
    m_Localized: "Ulubione t\u0142o: doch\xF3d {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616771
    m_Localized: "Odblokuj wi\u0119cej te\u0142, aby go zwi\u0119kszy\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616772
    m_Localized: Jeszcze nie znaleziono.
    m_Metadata:
      m_Items: []
  - m_Id: 13358496839811072
    m_Localized: "Zarobiona got\xF3wka"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496839811073
    m_Localized: "Efekty rosn\u0105 wraz z poziomem przedmiotu."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005376
    m_Localized: "Zwyk\u0142y"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005377
    m_Localized: "Niezwyk\u0142y"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005378
    m_Localized: Rzadki
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005379
    m_Localized: Epicki
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005380
    m_Localized: Unikatowy
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199680
    m_Localized: "L\u0105duj\u0105ce kamienie nape\u0142niaj\u0105 ten pasek. Gdy si\u0119 zape\u0142ni, awansujesz i zdob\u0119dziesz {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199681
    m_Localized: Pasek skrzyni
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199682
    m_Localized: "L\u0105duj\u0105ce kamienie nape\u0142niaj\u0105 ten pasek. Gdy si\u0119 zape\u0142ni, wypada skrzynia."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199683
    m_Localized: "Ko\u015Bci"
    m_Metadata:
      m_Items: []
