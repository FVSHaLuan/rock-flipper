      m_Items: []
  - m_Id: 13303223290871808
    m_Localized: "\u3059\u3079\u3066\u9589\u3058\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 13304211712163840
    m_Localized: "OK\u3001\u30D5\u30EA\u30C3\u30D7\u3057\u3088\u3046\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 13304398807482368
    m_Localized: "<b>Rock Flipper</b>\u306E<b>\u4F53\u9A13\u7248</b>\u3092\u30D7\u30EC\u30A4\u3057\u3066\u3044\u307E\u3059\u3002\u3053\u306E\u4F53\u9A13\u7248\u3067\u306F\u3001\u4F7F\u7528\u3067\u304D\u308B\u30B9\u30AD\u30EB\u3068\u30A2\u30A4\u30C6\u30E0\u304C<b>\u5236\u9650</b>\u3055\u308C\u3066\u3044\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
