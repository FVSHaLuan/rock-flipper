    m_Localized: "\u30E2\u30CE\u30EA\u30B9 L XII"
    m_Metadata:
      m_Items: []
  - m_Id: 13351213242171392
    m_Localized: "<b>\u4F53\u9A13\u7248\u306E\u5236\u9650\uFF01</b>\n\n\u3053\u308C\u306F\u4F53\u9A13\u7248\u306E\u5F37\u5316\u4E0A\u9650\u3067\u3059\u3002\u88FD\u54C1\u7248\u3067\u306F\u3001\u3055\u3089\u306B\u5F37\u5316\u3092\u7D9A\u3051\u305F\u308A\u3001\u3088\u308A\u591A\u304F\u306E\u30B9\u30AD\u30EB\u3092\u89E3\u653E\u3057\u305F\u308A\u3067\u304D\u307E\u3059\u3002\n\n<b>\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u88FD\u54C1\u7248\u3092\u30C1\u30A7\u30C3\u30AF\u3002</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616768
    m_Localized: "\u3055\u3089\u306B\u80CC\u666F\u3092\u89E3\u653E\u3057\u3088\u3046\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616769
    m_Localized: "\u304A\u3059\u3059\u3081\u80CC\u666F\u3092\u9078\u3076\u3068\u3001\u30AD\u30E3\u30C3\u30B7\u30E5\u53CE\u5165\u304C\u500D\u5897\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616770
    m_Localized: "\u304A\u3059\u3059\u3081\u80CC\u666F\uFF1A\u30AD\u30E3\u30C3\u30B7\u30E5\u53CE\u5165{0}\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616771
    m_Localized: "\u80CC\u666F\u3092\u3055\u3089\u306B\u89E3\u653E\u3059\u308B\u3068\u3001\u3053\u306E\u500D\u7387\u304C\u4E0A\u304C\u308A\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616772
    m_Localized: "\u307E\u3060\u898B\u3064\u304B\u3063\u3066\u3044\u307E\u305B\u3093\u3002"
