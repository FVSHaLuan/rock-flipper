  - m_Id: 13300708134535168
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u0444\u043E\u043D:"
    m_Metadata:
      m_Items: []
  - m_Id: 13300936485027840
    m_Localized: "\u0418\u0437\u0431\u0440\u0430\u043D\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 13301272792711168
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 13302028673400832
    m_Localized: "\u0424\u043B\u0438\u043F\u043F\u0435\u0440-\u0431\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 13302979580837888
    m_Localized: "\u041F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0441 \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u0442\u043E\u0447\u043A\u043E\u0439 \u2014 \u043D\u043E\u0432\u044B\u0435 \u0438\u043B\u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u043D\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 13303223290871808
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u044C \u0432\u0441\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 13304211712163840
    m_Localized: "\u041E\u041A, \u043F\u043E\u0434\u0431\u0440\u043E\u0441\u0438\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 13304398807482368
    m_Localized: "\u0412\u044B \u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0432 <b>\u0434\u0435\u043C\u043E\u0432\u0435\u0440\u0441\u0438\u044E</b> <b>Rock Flipper</b>. \u0412 \u044D\u0442\u043E\u0439 \u0434\u0435\u043C\u043E\u0432\u0435\u0440\u0441\u0438\u0438 <b>\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u044B</b> \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u043D\u0430\u0432\u044B\u043A\u0438 \u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 13345685015281664
    m_Localized: "\u0424\u043E\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 13349067394301952
    m_Localized: "\u0424\u043B\u0438\u043F\u043F\u0435\u0440-\u0431\u043E\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 13349071173369856
    m_Localized: "\u041C\u043E\u043D\u043E\u043B\u0438\u0442 L VIII"
    m_Metadata:
      m_Items: []
  - m_Id: 13349072561684480
    m_Localized: "\u041C\u043E\u043D\u043E\u043B\u0438\u0442 L II"
    m_Metadata:
      m_Items: []
  - m_Id: 13349073006280704
    m_Localized: "\u041C\u044B\u0448\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 13349075195707392
    m_Localized: "\u0412\u0441\u0435 \u043A\u0430\u043C\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 13349348899209216
    m_Localized: "\u041C\u043E\u043D\u043E\u043B\u0438\u0442 L IV"
    m_Metadata:
      m_Items: []
  - m_Id: 13349349234753536
    m_Localized: "\u041C\u043E\u043D\u043E\u043B\u0438\u0442 L VI"
    m_Metadata:
      m_Items: []
  - m_Id: 13349349897453568
    m_Localized: "\u041C\u043E\u043D\u043E\u043B\u0438\u0442 L X"
    m_Metadata:
      m_Items: []
  - m_Id: 13349350212026368
    m_Localized: "\u041C\u043E\u043D\u043E\u043B\u0438\u0442 L XII"
    m_Metadata:
      m_Items: []
  - m_Id: 13351213242171392
    m_Localized: "<b>\u041E\u0413\u0420\u0410\u041D\u0418\u0427\u0415\u041D\u0418\u0415 \u0414\u0415\u041C\u041E!</b>\n\n\u042D\u0442\u043E \u043F\u0440\u0435\u0434\u0435\u043B \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0439 \u0432 \u0434\u0435\u043C\u043E\u0432\u0435\u0440\u0441\u0438\u0438. \u0412 \u043F\u043E\u043B\u043D\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u043C\u043E\u0436\u043D\u043E \u0443\u043B\u0443\u0447\u0448\u0430\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435 \u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0435 \u043D\u0430\u0432\u044B\u043A\u0438.\n\n<b>\u041D\u0430\u0436\u043C\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C \u043E \u043F\u043E\u043B\u043D\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616768
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0439\u0442\u0435 \u043D\u043E\u0432\u044B\u0435 \u0444\u043E\u043D\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616769
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u0444\u043E\u043D, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u0443\u043C\u043D\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u0434\u043E\u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616770
    m_Localized: "\u0418\u0437\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u0444\u043E\u043D: \u0434\u043E\u0445\u043E\u0434 {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616771
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0439\u0442\u0435 \u043D\u043E\u0432\u044B\u0435 \u0444\u043E\u043D\u044B, \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C \u043C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616772
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496839811072
    m_Localized: "\u0417\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043E \u0434\u0435\u043D\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496839811073
    m_Localized: "\u042D\u0444\u0444\u0435\u043A\u0442\u044B \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0441 \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005376
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005377
    m_Localized: "\u041D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005378
    m_Localized: "\u0420\u0435\u0434\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005379
    m_Localized: "\u042D\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005380
    m_Localized: "\u0423\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199680
    m_Localized: "\u041F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u044F \u043A\u0430\u043C\u043D\u0435\u0439 \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u044E\u0442 \u044D\u0442\u0443 \u0448\u043A\u0430\u043B\u0443. \u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0441\u044F, \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u043D\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0438 {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199681
    m_Localized: "\u0428\u043A\u0430\u043B\u0430 \u0441\u0443\u043D\u0434\u0443\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199682
    m_Localized: "\u041F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u044F \u043A\u0430\u043C\u043D\u0435\u0439 \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u044E\u0442 \u044D\u0442\u0443 \u0448\u043A\u0430\u043B\u0443. \u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0441\u044F, \u0432\u044B\u043F\u0430\u0434\u0435\u0442 \u0441\u0443\u043D\u0434\u0443\u043A."
    m_Metadata:
      m_Items: []
