    m_Localized: Souris
    m_Metadata:
      m_Items: []
  - m_Id: 13349075195707392
    m_Localized: Toutes les pierres
    m_Metadata:
      m_Items: []
  - m_Id: 13349348899209216
    m_Localized: Monolithe L IV
    m_Metadata:
      m_Items: []
  - m_Id: 13349349234753536
