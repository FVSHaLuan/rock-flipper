  - m_Id: 13300708134535168
    m_Localized: "Proch. d\xE9cor pr\xE9f\xE9r\xE9 :"
    m_Metadata:
      m_Items: []
  - m_Id: 13300936485027840
    m_Localized: "Pr\xE9f\xE9r\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 13301272792711168
    m_Localized: "D\xE9bloquer au hasard"
    m_Metadata:
      m_Items: []
  - m_Id: 13302028673400832
    m_Localized: Robot lanceur
    m_Metadata:
      m_Items: []
  - m_Id: 13302979580837888
    m_Localized: "Les objets avec un point rouge sont nouveaux ou ont mont\xE9 de niveau."
    m_Metadata:
      m_Items: []
  - m_Id: 13303223290871808
    m_Localized: Tout ignorer
    m_Metadata:
      m_Items: []
  - m_Id: 13304211712163840
    m_Localized: OK, on lance !
    m_Metadata:
      m_Items: []
  - m_Id: 13304398807482368
    m_Localized: "Vous jouez \xE0 la version <b>d\xE9mo</b> de <b>Rock Flipper</b>. Cette d\xE9mo <b>limite</b> les comp\xE9tences et les objets disponibles."
    m_Metadata:
      m_Items: []
  - m_Id: 13345685015281664
    m_Localized: "D\xE9cors"
    m_Metadata:
      m_Items: []
  - m_Id: 13349067394301952
    m_Localized: Robots lanceurs
    m_Metadata:
      m_Items: []
  - m_Id: 13349071173369856
    m_Localized: Monolithe L VIII
    m_Metadata:
      m_Items: []
