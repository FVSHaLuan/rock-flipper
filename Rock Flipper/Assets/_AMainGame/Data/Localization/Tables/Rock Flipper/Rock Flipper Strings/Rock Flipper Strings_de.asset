  - m_Id: 13351213242171392
    m_Localized: "<b>DEMO-LIMIT!</b>\n\nDas ist die Upgrade-Grenze der Demo. In der Vollversion kannst du weiter upgraden und mehr F\xE4higkeiten freischalten.\n\n<b>Klicke, um dir die Vollversion anzusehen.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616768
    m_Localized: "Schalte mehr Hintergr\xFCnde frei!"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616769
    m_Localized: "W\xE4hle den bevorzugten Hintergrund f\xFCr ein vervielfachtes Einkommen."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616770
    m_Localized: 'Bevorzugter Hintergrund: {0} Einkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616771
    m_Localized: "Schalte mehr Hintergr\xFCnde frei, um den Multiplikator zu erh\xF6hen."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616772
    m_Localized: Noch nicht gefunden.
    m_Metadata:
      m_Items: []
  - m_Id: 13358496839811072
    m_Localized: Verdientes Geld
    m_Metadata:
      m_Items: []
  - m_Id: 13358496839811073
    m_Localized: Die Effekte wachsen mit der Item-Stufe.
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005376
    m_Localized: "Gew\xF6hnlich"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005377
