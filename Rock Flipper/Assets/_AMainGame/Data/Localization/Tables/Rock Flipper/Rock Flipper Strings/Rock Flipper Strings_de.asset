    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199680
    m_Localized: "Landende Steine f\xFCllen diese Leiste. Wenn sie voll ist, steigst du eine Stufe auf und erh\xE4ltst {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199681
    m_Localized: Truhenleiste
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199682
    m_Localized: "Landende Steine f\xFCllen diese Leiste. Wenn sie voll ist, f\xE4llt eine Truhe."
