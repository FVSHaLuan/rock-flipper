  - m_Id: 13300708134535168
    m_Localized: "N\xE4chster bevorzugter Hintergr.:"
    m_Metadata:
      m_Items: []
  - m_Id: 13300936485027840
    m_Localized: Bevorzugt
    m_Metadata:
      m_Items: []
  - m_Id: 13301272792711168
    m_Localized: "Zuf\xE4llig freischalten"
    m_Metadata:
      m_Items: []
  - m_Id: 13302028673400832
    m_Localized: Wurfbot
    m_Metadata:
      m_Items: []
  - m_Id: 13302979580837888
    m_Localized: Items mit rotem Punkt sind neu gefunden oder eine Stufe aufgestiegen.
    m_Metadata:
      m_Items: []
  - m_Id: 13303223290871808
    m_Localized: Alle ausblenden
    m_Metadata:
      m_Items: []
  - m_Id: 13304211712163840
    m_Localized: OK, wirf ihn!
    m_Metadata:
      m_Items: []
  - m_Id: 13304398807482368
    m_Localized: "Du spielst die <b>Demoversion</b> von <b>Rock Flipper</b>. Diese Demo <b>begrenzt</b> die verf\xFCgbaren F\xE4higkeiten und Items."
    m_Metadata:
      m_Items: []
  - m_Id: 13345685015281664
    m_Localized: "Hintergr\xFCnde"
    m_Metadata:
      m_Items: []
  - m_Id: 13349067394301952
    m_Localized: Wurfbots
    m_Metadata:
      m_Items: []
