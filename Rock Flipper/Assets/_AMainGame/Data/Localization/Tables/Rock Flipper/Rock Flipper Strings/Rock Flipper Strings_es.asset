    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199680
    m_Localized: Los aterrizajes de rocas llenan esta barra. Cuando se llena, subes de nivel y ganas {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199681
