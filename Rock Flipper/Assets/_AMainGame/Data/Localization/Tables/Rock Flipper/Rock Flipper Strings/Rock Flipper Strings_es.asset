  - m_Id: 13300708134535168
    m_Localized: "Pr\xF3x. fondo preferido:"
    m_Metadata:
      m_Items: []
  - m_Id: 13300936485027840
    m_Localized: Preferido
    m_Metadata:
      m_Items: []
  - m_Id: 13301272792711168
    m_Localized: Desbloquear al azar
    m_Metadata:
      m_Items: []
  - m_Id: 13302028673400832
    m_Localized: Bot volteador
    m_Metadata:
      m_Items: []
  - m_Id: 13302979580837888
    m_Localized: Los objetos con un punto rojo son nuevos o han subido de nivel.
    m_Metadata:
      m_Items: []
  - m_Id: 13303223290871808
    m_Localized: Descartar todo
    m_Metadata:
      m_Items: []
  - m_Id: 13304211712163840
    m_Localized: "\xA1Vale, a voltear!"
    m_Metadata:
      m_Items: []
  - m_Id: 13304398807482368
    m_Localized: "Est\xE1s jugando a la versi\xF3n <b>demo</b> de <b>Rock Flipper</b>. Esta demo <b>limita</b> las habilidades y los objetos disponibles."
    m_Metadata:
      m_Items: []
  - m_Id: 13345685015281664
    m_Localized: Fondos
    m_Metadata:
      m_Items: []
  - m_Id: 13349067394301952
    m_Localized: Bots volteadores
    m_Metadata:
      m_Items: []
  - m_Id: 13349071173369856
    m_Localized: Monolito L VIII
    m_Metadata:
      m_Items: []
  - m_Id: 13349072561684480
    m_Localized: Monolito L II
    m_Metadata:
      m_Items: []
  - m_Id: 13349073006280704
    m_Localized: "Rat\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 13349075195707392
    m_Localized: Todas las rocas
    m_Metadata:
      m_Items: []
  - m_Id: 13349348899209216
    m_Localized: Monolito L IV
    m_Metadata:
      m_Items: []
  - m_Id: 13349349234753536
    m_Localized: Monolito L VI
    m_Metadata:
