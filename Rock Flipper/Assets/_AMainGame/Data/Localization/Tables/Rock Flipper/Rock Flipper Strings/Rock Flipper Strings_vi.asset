    m_Metadata:
      m_Items: []
  - m_Id: 7262829461504
    m_Localized: "\u0110\xE1 P5"
    m_Metadata:
      m_Items: []
  - m_Id: 13300708134535168
    m_Localized: "N\u1EC1n \u01B0a th\xEDch ti\u1EBFp theo:"
    m_Metadata:
      m_Items: []
  - m_Id: 13300936485027840
    m_Localized: "\u01AFa th\xEDch"
    m_Metadata:
      m_Items: []
  - m_Id: 13301272792711168
    m_Localized: "M\u1EDF kh\xF3a ng\u1EABu nhi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 13302028673400832
    m_Localized: "Bot tung \u0111\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 13302979580837888
    m_Localized: "V\u1EADt ph\u1EA9m c\xF3 ch\u1EA5m \u0111\u1ECF l\xE0 v\u1EADt ph\u1EA9m m\u1EDBi t\xECm th\u1EA5y ho\u1EB7c v\u1EEBa l\xEAn c\u1EA5p."
    m_Metadata:
      m_Items: []
  - m_Id: 13303223290871808
    m_Localized: "B\u1ECF qua t\u1EA5t c\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 13304211712163840
    m_Localized: "OK, tung \u0111\xE1 th\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 13304398807482368
    m_Localized: "B\u1EA1n \u0111ang ch\u01A1i phi\xEAn b\u1EA3n <b>demo</b> c\u1EE7a <b>Rock Flipper</b>. B\u1EA3n demo n\xE0y <b>gi\u1EDBi h\u1EA1n</b> c\xE1c k\u1EF9 n\u0103ng v\xE0 v\u1EADt ph\u1EA9m c\xF3 s\u1EB5n."
    m_Metadata:
      m_Items: []
  - m_Id: 13345685015281664
    m_Localized: "Ph\xF4ng n\u1EC1n"
    m_Metadata:
      m_Items: []
  - m_Id: 13349067394301952
    m_Localized: "Bot tung \u0111\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 13349071173369856
    m_Localized: Monolith L VIII
    m_Metadata:
      m_Items: []
  - m_Id: 13349072561684480
    m_Localized: Monolith L II
    m_Metadata:
      m_Items: []
  - m_Id: 13349073006280704
    m_Localized: "Chu\u1ED9t"
    m_Metadata:
      m_Items: []
  - m_Id: 13349075195707392
    m_Localized: "M\u1ECDi vi\xEAn \u0111\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 13349348899209216
    m_Localized: Monolith L IV
    m_Metadata:
      m_Items: []
  - m_Id: 13349349234753536
    m_Localized: Monolith L VI
    m_Metadata:
      m_Items: []
  - m_Id: 13349349897453568
    m_Localized: Monolith L X
    m_Metadata:
      m_Items: []
  - m_Id: 13349350212026368
    m_Localized: Monolith L XII
    m_Metadata:
      m_Items: []
  - m_Id: 13351213242171392
    m_Localized: "<b>GI\u1EDAI H\u1EA0N DEMO!</b>\n\n\u0110\xE2y l\xE0 m\u1EE9c n\xE2ng c\u1EA5p t\u1ED1i \u0111a c\u1EE7a b\u1EA3n demo. Trong b\u1EA3n \u0111\u1EA7y \u0111\u1EE7, b\u1EA1n c\xF3 th\u1EC3 ti\u1EBFp t\u1EE5c n\xE2ng c\u1EA5p v\xE0 m\u1EDF kh\xF3a th\xEAm k\u1EF9 n\u0103ng.\n\n<b>Nh\u1EA5p \u0111\u1EC3 xem b\u1EA3n \u0111\u1EA7y \u0111\u1EE7.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616768
    m_Localized: "M\u1EDF kh\xF3a th\xEAm ph\xF4ng n\u1EC1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616769
    m_Localized: "Ch\u1ECDn ph\xF4ng n\u1EC1n \u01AFa th\xEDch \u0111\u1EC3 nh\xE2n thu nh\u1EADp."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616770
    m_Localized: "Ph\xF4ng n\u1EC1n \u01B0a th\xEDch: {0} thu nh\u1EADp."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616771
    m_Localized: "M\u1EDF kh\xF3a th\xEAm ph\xF4ng n\u1EC1n \u0111\u1EC3 t\u0103ng h\u1EC7 s\u1ED1 n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616772
    m_Localized: "Ch\u01B0a t\xECm th\u1EA5y."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496839811072
    m_Localized: "Ti\u1EC1n \u0111\xE3 ki\u1EBFm"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496839811073
    m_Localized: "Hi\u1EC7u \u1EE9ng t\u0103ng theo c\u1EA5p v\u1EADt ph\u1EA9m."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005376
    m_Localized: "Th\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005377
    m_Localized: "\xCDt g\u1EB7p"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005378
    m_Localized: "Hi\u1EBFm"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005379
    m_Localized: "S\u1EED thi"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005380
    m_Localized: "\u0110\u1ED9c nh\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199680
    m_Localized: "\u0110\xE1 ti\u1EBFp \u0111\u1EA5t s\u1EBD l\xE0m \u0111\u1EA7y thanh n\xE0y. Khi \u0111\u1EA7y, b\u1EA1n s\u1EBD l\xEAn c\u1EA5p v\xE0 nh\u1EADn {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199681
    m_Localized: "Thanh r\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199682
    m_Localized: "\u0110\xE1 ti\u1EBFp \u0111\u1EA5t s\u1EBD l\xE0m \u0111\u1EA7y thanh n\xE0y. Khi \u0111\u1EA7y, m\u1ED9t r\u01B0\u01A1ng s\u1EBD r\u01A1i ra."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199683
    m_Localized: "X\xFAc x\u1EAFc"
    m_Metadata:
      m_Items: []
  - m_Id: 13358497351516160
    m_Localized: "B\xFAa"
    m_Metadata:
      m_Items: []
  - m_Id: 13358497661894656
    m_Localized: "\u0110\xE8n l\u1ED3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 13358497976467456
    m_Localized: "K\xEDnh l\xFAp"
    m_Metadata:
      m_Items: []
  - m_Id: 13358498303623168
    m_Localized: "Cu\u1ED1c chim"
    m_Metadata:
      m_Items: []
  - m_Id: 13358498626584576
    m_Localized: "X\xE0 ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 13358498936963072
    m_Localized: "L\xF2 xo"
    m_Metadata:
      m_Items: []
  - m_Id: 13358499234758656
    m_Localized: "V\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 13358499545137152
    m_Localized: "Sa m\u1EA1c"
    m_Metadata:
      m_Items: []
  - m_Id: 13358499553525760
    m_Localized: "\u0110\u1ED3ng c\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 13358499553525761
    m_Localized: "Sao H\u1ECFa"
    m_Metadata:
      m_Items: []
  - m_Id: 13358499553525762
    m_Localized: "L\xE3nh nguy\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 13358499553525763
    m_Localized: "N\xFAi l\u1EEDa"
    m_Metadata:
      m_Items: []
