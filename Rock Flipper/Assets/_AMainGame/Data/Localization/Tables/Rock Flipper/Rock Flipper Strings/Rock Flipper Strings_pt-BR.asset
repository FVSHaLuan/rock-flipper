    m_Metadata:
      m_Items: []
  - m_Id: 13349075195707392
    m_Localized: Todas as pedras
    m_Metadata:
      m_Items: []
  - m_Id: 13349348899209216
    m_Localized: "Mon\xF3lito L IV"
    m_Metadata:
      m_Items: []
  - m_Id: 13349349234753536
    m_Localized: "Mon\xF3lito L VI"
    m_Metadata:
      m_Items: []
  - m_Id: 13349349897453568
    m_Localized: "Mon\xF3lito L X"
    m_Metadata:
      m_Items: []
  - m_Id: 13349350212026368
    m_Localized: "Mon\xF3lito L XII"
    m_Metadata:
      m_Items: []
  - m_Id: 13351213242171392
    m_Localized: "<b>LIMITE DA DEMO!</b>\n\nEste \xE9 o limite de melhorias da demo. No jogo completo, voc\xEA pode continuar melhorando e desbloquear mais habilidades.\n\n<b>Clique para conhecer o jogo completo.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616768
    m_Localized: Desbloqueie mais fundos!
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616769
    m_Localized: Selecione o fundo preferido para multiplicar sua renda.
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616770
    m_Localized: 'Fundo preferido: renda {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616771
    m_Localized: "Desbloqueie mais fundos para aument\xE1-lo."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496835616772
    m_Localized: "Ainda n\xE3o encontrado."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496839811072
    m_Localized: Dinheiro ganho
    m_Metadata:
      m_Items: []
  - m_Id: 13358496839811073
    m_Localized: "Os efeitos aumentam com o n\xEDvel do item."
    m_Metadata:
      m_Items: []
  - m_Id: 13358496844005376
    m_Localized: Comum
    m_Metadata:
      m_Items: []
