    m_Metadata:
      m_Items: []
  - m_Id: 13358496848199680
    m_Localized: "Pousos de pedras enchem esta barra. Quando ela estiver cheia, voc\xEA sobe de n\xEDvel e ganha {0}."
    m_Metadata:
      m_Items: []
