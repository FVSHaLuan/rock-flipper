  - m_Id: 13300708134535168
    m_Localized: "Pr\xF3x. fundo preferido:"
    m_Metadata:
      m_Items: []
  - m_Id: 13300936485027840
    m_Localized: Preferido
    m_Metadata:
      m_Items: []
  - m_Id: 13301272792711168
    m_Localized: "Desbloquear aleat\xF3rio"
    m_Metadata:
      m_Items: []
  - m_Id: 13302028673400832
    m_Localized: "Bot lan\xE7ador"
    m_Metadata:
      m_Items: []
  - m_Id: 13302979580837888
    m_Localized: "Itens com um ponto vermelho s\xE3o novos ou subiram de n\xEDvel."
    m_Metadata:
      m_Items: []
  - m_Id: 13303223290871808
    m_Localized: Dispensar tudo
    m_Metadata:
      m_Items: []
  - m_Id: 13304211712163840
    m_Localized: "OK, vamos lan\xE7ar!"
    m_Metadata:
      m_Items: []
  - m_Id: 13304398807482368
    m_Localized: "Voc\xEA est\xE1 jogando a vers\xE3o <b>demo</b> de <b>Rock Flipper</b>. Esta demo <b>limita</b> as habilidades e os itens dispon\xEDveis."
    m_Metadata:
      m_Items: []
  - m_Id: 13345685015281664
    m_Localized: Fundos
    m_Metadata:
      m_Items: []
  - m_Id: 13349067394301952
    m_Localized: "Bots lan\xE7adores"
    m_Metadata:
      m_Items: []
  - m_Id: 13349071173369856
    m_Localized: "Mon\xF3lito L VIII"
    m_Metadata:
      m_Items: []
  - m_Id: 13349072561684480
    m_Localized: "Mon\xF3lito L II"
    m_Metadata:
      m_Items: []
