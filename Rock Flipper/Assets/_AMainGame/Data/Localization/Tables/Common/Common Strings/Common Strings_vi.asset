  m_TableData:
  - m_Id: 2004501839872
    m_Localized: "\u0110\u1ED3ng t\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 186187592019968
    m_Localized: "Ti\u1EBFng Vi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 156459602587648
    m_Localized: "Ko \u0111\u1ED3ng t\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 357107782692864
    m_Localized: "Ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 500106160287744
    m_Localized: Steam Deck
    m_Metadata:
      m_Items: []
  - m_Id: 512897407561728
    m_Localized: "\u0110ang ph\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 514730469404672
    m_Localized: "Th\u1EDDi gian ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 156586840993792
    m_Localized: "Tho\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 304893903024128
    m_Localized: "C\xE1c ng\xF4n ng\u1EEF kh\xE1c ngo\xE0i ti\u1EBFng Anh \u0111\xE3
      \u0111\u01B0\u1EE3c d\u1ECBch b\u1EB1ng AI.\nM\u1ED9t s\u1ED1 v\u0103n b\u1EA3n
      c\xF3 th\u1EC3 ch\u1EE9a l\u1ED7i ho\u1EB7c nghe kh\xF4ng t\u1EF1 nhi\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 304941520957440
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 c\u1EA7n kh\u1EDFi \u0111\u1ED9ng l\u1EA1i
      tr\xF2 ch\u01A1i n\u1EBFu ng\xF4n ng\u1EEF m\u1EDBi ch\u01B0a \u0111\u01B0\u1EE3c
      \xE1p d\u1EE5ng ho\xE0n to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 357156944130048
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 357334509989888
    m_Localized: "Ph\u1EA3n h\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 357913294581760
    m_Localized: "Theo d\xF5i t\xF4i tr\xEAn Steam"
    m_Metadata:
      m_Items: []
  - m_Id: 501445913260032
    m_Localized: "B\u1EA1n c\xF3 ch\u1EAFc ch\u1EAFn mu\u1ED1n tho\xE1t kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 514236262952960
    m_Localized: "Ch\u1ECDn \xF4 l\u01B0u"
    m_Metadata:
      m_Items: []
  - m_Id: 514308245598208
    m_Localized: "Kh\xF4ng t\u01B0\u01A1ng th\xEDch"
    m_Metadata:
      m_Items: []
  - m_Id: 514586902573056
    m_Localized: "\xD4 l\u01B0u"
    m_Metadata:
      m_Items: []
  - m_Id: 514966227038208
    m_Localized: "\u0110i\u1EC3m k\u1EF9 n\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 515050083758080
    m_Localized: "M\xE0n tr\xF9m"
    m_Metadata:
      m_Items: []
  - m_Id: 516184986923008
    m_Localized: "Kh\xF4ng c\xF3 d\u1EEF li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 516414255968256
